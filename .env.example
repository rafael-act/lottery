# =====================================================================
#  Configuração do sistema - copie este arquivo para ".env" e ajuste
# =====================================================================

# Porta HTTP da aplicação
PORT=3000

# ---------------------------------------------------------------------
#  Banco de dados
#  DB_CLIENT: "sqlite" (arquivo local, nenhuma instalação necessária)
#             "postgres" (recomendado para produção)
# ---------------------------------------------------------------------
DB_CLIENT=sqlite

# SQLite - caminho do arquivo (criado automaticamente)
SQLITE_FILE=./data/loterias.db

# PostgreSQL - usados somente quando DB_CLIENT=postgres
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=loterias
PG_USER=loterias_app
PG_PASSWORD=troque_esta_senha
PG_SSL=false

# ---------------------------------------------------------------------
#  Análise
# ---------------------------------------------------------------------
# Janela padrão (em anos) usada nas estatísticas e sugestões
ANOS_ANALISE=2

# ---------------------------------------------------------------------
#  Importação dos resultados (API pública da Caixa)
# ---------------------------------------------------------------------
CAIXA_API_URL=https://servicebus2.caixa.gov.br/portaldeloterias/api
# Quantos anos para trás importar
IMPORT_ANOS=2
# Requisições simultâneas e pausa entre lotes (evita bloqueio da API)
IMPORT_CONCORRENCIA=4
IMPORT_PAUSA_MS=300
# Tentativas por concurso em caso de falha
IMPORT_TENTATIVAS=4
